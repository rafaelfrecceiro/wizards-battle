{
  "name": "wizards-battle",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx tests/simulate.ts",
    "simulate:ves": "tsx tests/ves-simulate.ts",
    "test:http": "tsx tests/http-smoke.ts",
    "test:http:decks": "tsx tests/http-decks.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
